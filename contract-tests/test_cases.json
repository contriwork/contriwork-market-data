{
  "$schema_note": "Cross-language contract fixture. Python (pytest), C# (xUnit) and TypeScript (vitest) MUST load this file and produce identical results for every case. Fixture shape is stable within one schema_version; bumping schema_version requires updating all three runners in the same PR.",
  "schema_version": 1,
  "contract_revision": "v1",
  "example_case_shape": {
    "name": "kebab-case identifier, must be unique within `cases`",
    "description": "one-line human summary",
    "setup": {
      "adapters": [
        {
          "id": "stable kebab-case adapter id; runner registers an InMemoryAdapter with this id and the supplied dataset",
          "data": "object keyed by symbol; values describe what the adapter returns for spot/ohlcv/order_book/ticker",
          "supports_native_streaming": "optional bool (default false)",
          "supports_order_book": "optional bool (default true)",
          "supported_quote_currencies": "optional list[str] or 'ANY' (default 'ANY')",
          "rate_limit_per_minute": "optional int (default 9999, effectively unlimited)",
          "fail_modes": "optional list of {symbol, code} entries forcing the adapter to raise the given error code on operations for that symbol"
        }
      ],
      "client_chain": "object: market -> ordered list[adapter_id]",
      "cache": "optional client cache config (enabled, spot_ttl_s, ohlcv_ttl_s, order_book_ttl_s)",
      "rate_limit": "optional client rate-limit config (enabled, strategy, max_retry_attempts, initial_backoff_s)",
      "streaming": "optional streaming config (default_polling_interval_s, max_reconnect_attempts)",
      "clock": "optional initial epoch_seconds and tick advances (deterministic time injection)"
    },
    "operation": {
      "method": "get_spot | get_ohlcv | get_order_book | subscribe_ticker",
      "args": "object of named arguments per CONTRACT.md §3"
    },
    "expected_output": "object describing the type and required field values; null if expected_error is set",
    "expected_error": {
      "code": "stable SCREAMING_SNAKE_CASE error code from CONTRACT.md §7",
      "message_contains": "optional substring; null to skip"
    },
    "tags": ["happy-path", "edge-case", "fallback", "cache", "rate-limit", "streaming", "security"],
    "skip_languages": []
  },
  "cases": [
    {
      "name": "get-spot-success-from-primary-adapter",
      "description": "Primary adapter returns immediately; secondary is never queried.",
      "setup": {
        "adapters": [
          {
            "id": "primary",
            "data": {"BTCUSDT": {"spot": {"last": "65000.00", "quote_currency": "USDT", "volume_24h": "12345.6"}}}
          },
          {"id": "secondary", "data": {}}
        ],
        "client_chain": {"crypto": ["primary", "secondary"]}
      },
      "operation": {
        "method": "get_spot",
        "args": {"symbol": "BTCUSDT", "market": "crypto", "quote_currency": "USDT"}
      },
      "expected_output": {
        "type": "SpotPrice",
        "fields": {
          "symbol": "BTCUSDT",
          "last": "65000.00",
          "quote_currency": "USDT",
          "source_adapter": "primary"
        }
      },
      "expected_error": null,
      "tags": ["happy-path", "spot"],
      "skip_languages": []
    },
    {
      "name": "get-spot-fallback-when-primary-symbol-not-found",
      "description": "Primary raises SYMBOL_NOT_FOUND; secondary succeeds; client returns secondary's value.",
      "setup": {
        "adapters": [
          {
            "id": "primary",
            "data": {},
            "fail_modes": [{"symbol": "ETHUSDT", "code": "SYMBOL_NOT_FOUND"}]
          },
          {
            "id": "secondary",
            "data": {"ETHUSDT": {"spot": {"last": "3500.00", "quote_currency": "USDT"}}}
          }
        ],
        "client_chain": {"crypto": ["primary", "secondary"]}
      },
      "operation": {
        "method": "get_spot",
        "args": {"symbol": "ETHUSDT", "market": "crypto", "quote_currency": "USDT"}
      },
      "expected_output": {
        "type": "SpotPrice",
        "fields": {"symbol": "ETHUSDT", "last": "3500.00", "source_adapter": "secondary"}
      },
      "expected_error": null,
      "tags": ["fallback", "spot"],
      "skip_languages": []
    },
    {
      "name": "get-spot-all-adapters-fail-aggregates-causes",
      "description": "Every adapter in the chain raises; orchestrator raises ALL_ADAPTERS_FAILED with non-empty cause list.",
