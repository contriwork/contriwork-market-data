    {
      "name": "rate-limit-retry-then-success",
      "description": "Adapter returns RATE_LIMITED on first call, succeeds on retry; with rate_limit.enabled=true, default backoff and max_retry_attempts>=1, orchestrator returns the second-call result.",
      "setup": {
        "adapters": [
          {
            "id": "p",
