      "operation": {
        "method": "get_spot",
        "args": {"symbol": "BTCUSDT", "market": "crypto", "quote_currency": "USDT"}
      },
      "expected_output": {
        "type": "SpotPrice",
        "fields": {"symbol": "BTCUSDT", "last": "65000", "source_adapter": "p"},
        "adapter_call_count": {"p": 2}
      },
