    {
      "name": "subscribe-ticker-polling-emulation-yields-tickers",
      "description": "Adapter has no native streaming; with polling_fallback=true the orchestrator emulates streaming via repeated get_spot, yielding 3 tickers spaced by polling_interval_s.",
      "setup": {
        "adapters": [
          {
            "id": "p",
            "data": {"BTCUSDT": {"spot": {"last": "65000", "quote_currency": "USDT"}}},
            "supports_native_streaming": false
