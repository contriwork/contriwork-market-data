    {
      "name": "subscribe-ticker-native-yields-tickers-then-cancel",
      "description": "Adapter advertises native streaming; iterator yields 3 tickers from a pre-seeded stream, then caller cancels.",
      "setup": {
        "adapters": [
          {
            "id": "p",
            "data": {
              "BTCUSDT": {
                "ticker_stream": [
                  {"price": "65000", "timestamp": "2026-04-30T12:00:00Z"},
                  {"price": "65001", "timestamp": "2026-04-30T12:00:01Z"},
                  {"price": "65002", "timestamp": "2026-04-30T12:00:02Z"}
                ]
              }
            },
            "supports_native_streaming": true
          }
        ],
        "client_chain": {"crypto": ["p"]}
      },
      "operation": {
        "method": "subscribe_ticker",
        "args": {"symbol": "BTCUSDT", "market": "crypto", "polling_fallback": false},
        "yield_count": 3,
        "cancel_after_yields": true
      },
      "expected_output": {
        "type": "list[Ticker]",
        "length": 3,
        "all_have_field": "source_adapter:p"
      },
      "expected_error": null,
