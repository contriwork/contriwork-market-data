          {"id": "primary", "data": {}, "fail_modes": [{"symbol": "XRPUSDT", "code": "ADAPTER_UNAVAILABLE"}]},
          {"id": "secondary", "data": {}, "fail_modes": [{"symbol": "XRPUSDT", "code": "ADAPTER_UNAVAILABLE"}]}
        ],
        "client_chain": {"crypto": ["primary", "secondary"]}
      },
      "operation": {
        "method": "get_spot",
        "args": {"symbol": "XRPUSDT", "market": "crypto", "quote_currency": "USDT"}
      },
      "expected_output": null,
      "expected_error": {"code": "ALL_ADAPTERS_FAILED", "message_contains": null},
      "tags": ["fallback", "spot", "error"],
      "skip_languages": []
    },
    {
      "name": "get-spot-no-adapter-for-market",
