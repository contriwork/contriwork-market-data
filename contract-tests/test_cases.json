            "id": "p",
            "data": {
              "BTCUSDT": {
                "ohlcv": {
                  "M1": [
                    {"timestamp": "2026-04-30T12:00:00Z", "open": "100", "high": "101", "low": "99", "close": "100", "volume": "1"},
                    {"timestamp": "2026-04-30T12:01:00Z", "open": "100", "high": "101", "low": "99", "close": "100", "volume": "1"},
                    {"timestamp": "2026-04-30T12:02:00Z", "open": "100", "high": "101", "low": "99", "close": "100", "volume": "1"},
                    {"timestamp": "2026-04-30T12:03:00Z", "open": "100", "high": "101", "low": "99", "close": "100", "volume": "1"},
                    {"timestamp": "2026-04-30T12:04:00Z", "open": "100", "high": "101", "low": "99", "close": "100", "volume": "1"}
                  ]
                }
              }
