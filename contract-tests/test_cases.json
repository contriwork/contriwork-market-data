    {
      "name": "get-spot-unsupported-quote-currency-raises",
      "description": "Single-adapter chain whose Capability.supported_quote_currencies excludes the requested currency raises UNSUPPORTED_QUOTE_CURRENCY.",
      "setup": {
        "adapters": [
          {
            "id": "usd-only",
