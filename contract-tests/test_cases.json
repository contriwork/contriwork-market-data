      },
      "operation": {
        "method": "get_spot",
        "args": {"symbol": "AAPL", "market": "stocks_us", "quote_currency": "TRY"}
      },
      "expected_output": null,
      "expected_error": {"code": "UNSUPPORTED_QUOTE_CURRENCY", "message_contains": "TRY"},
      "tags": ["error", "spot", "edge-case"],
      "skip_languages": []
    },
    {
      "name": "get-spot-cache-hit-returns-cached-value-without-adapter-call",
      "description": "Two consecutive get_spot calls within spot_ttl_s — second hits the cache and the adapter call counter increments by exactly one.",
      "setup": {
        "adapters": [
          {
            "id": "p",
            "data": {"BTCUSDT": {"spot": {"last": "65000", "quote_currency": "USDT"}}}
          }
        ],
        "client_chain": {"crypto": ["p"]},
        "cache": {"enabled": true, "spot_ttl_s": 5},
        "clock": {"epoch_seconds": 1714492800}
      },
      "operation": {
        "method": "get_spot",
        "args": {"symbol": "BTCUSDT", "market": "crypto", "quote_currency": "USDT"},
        "repeat": 2,
        "advance_clock_between_calls_s": 1
      },
      "expected_output": {
        "type": "SpotPrice",
        "fields": {"symbol": "BTCUSDT", "source_adapter": "p"},
        "adapter_call_count": {"p": 1}
      },
      "expected_error": null,
      "tags": ["cache", "spot"],
      "skip_languages": []
    },
    {
      "name": "get-ohlcv-success-returns-candles-ascending",
      "description": "Adapter returns 3 candles; orchestrator returns them ordered ascending by timestamp.",
      "setup": {
        "adapters": [
          {
            "id": "p",
            "data": {
              "BTCUSDT": {
                "ohlcv": {
                  "M1": [
                    {"timestamp": "2026-04-30T12:00:00Z", "open": "100", "high": "110", "low": "95", "close": "105", "volume": "1.0"},
                    {"timestamp": "2026-04-30T12:01:00Z", "open": "105", "high": "115", "low": "100", "close": "112", "volume": "1.2"},
                    {"timestamp": "2026-04-30T12:02:00Z", "open": "112", "high": "120", "low": "108", "close": "118", "volume": "0.8"}
                  ]
                }
              }
            }
          }
        ],
        "client_chain": {"crypto": ["p"]}
      },
      "operation": {
        "method": "get_ohlcv",
        "args": {"symbol": "BTCUSDT", "market": "crypto", "interval": "M1", "limit": 3}
      },
      "expected_output": {
        "type": "list[Candle]",
        "length": 3,
        "ordered_ascending_by": "timestamp"
      },
      "expected_error": null,
      "tags": ["happy-path", "ohlcv"],
      "skip_languages": []
    },
