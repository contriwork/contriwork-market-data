{
  "name": "@contriwork/market-data",
  "version": "0.0.0",
  "description": "Unified market-data port — spot, OHLCV, order book, ticker streaming. 10 adapters: CoinGecko, CoinMarketCap, Binance, Kraken, Coinbase, Alpha Vantage, Finnhub, IEX Cloud, Polygon.io, Tiingo. TTL cache + per-adapter rate limiting + ordered fallback. Cross-language sibling of contriwork-market-data (PyPI) and Contriwork.MarketData (NuGet). YFinance adapter is Python-only.",
  "type": "module",
  "license": "MIT",
  "author": "ContriWork",
  "homepage": "https://github.com/contriwork/contriwork-market-data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contriwork/contriwork-market-data.git"
  },
  "bugs": {
    "url": "https://github.com/contriwork/contriwork-market-data/issues"
  },
  "keywords": [
    "market-data",
    "crypto",
    "stocks",
    "ohlcv",
    "ticker",
    "order-book",
    "streaming",
    "websocket",
    "coingecko",
    "coinmarketcap",
    "binance",
    "kraken",
    "coinbase",
    "alpha-vantage",
    "finnhub",
    "iex-cloud",
    "polygon",
    "tiingo",
    "contriwork"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist && node scripts/copy-types-cjs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "prettier": "^3.8.4",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  }
}
